{
  "manifest_version": 3,
  "name": "TraderApe — ESPN Helper",
  "short_name": "TraderApe ESPN",
  "version": "0.2.2",
  "description": "Skip the DevTools step. Reads your ESPN espn_s2 and SWID cookies and hands them to the TraderApe web app so you can import private leagues with one click.",
  "permissions": ["cookies"],
  "host_permissions": [
    "https://*.espn.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TraderApe ESPN Helper",
    "default_popup": "popup.html"
  },
  "externally_connectable": {
    "matches": [
      "https://www.traderape.me/*",
      "https://traderape.me/*"
    ]
  }
}
